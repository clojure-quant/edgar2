{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.1"}
        com.github.clojure-finance/edgarjure {:mvn/version "0.4.1"}
        io.github.clojure-quant/quanta-eodhd {:mvn/version "0.1.3"}
        org.pinkgorilla/timbre {:mvn/version "0.0.8"}
        scicloj/tablecloth {:mvn/version "8.024"}}
 :aliases
 {:test {:extra-paths ["test"]
         :main-opts ["-e" "(require '[clojure.test :as t] '[clojure.java.io :as io] '[clojure.string :as str]) (let [nses (->> (.listFiles (io/file \"test/edgar2\")) (map #(.getName %)) (filter #(.endsWith % \"_test.clj\")) (map #(-> % (subs 0 (- (count %) 4)) (str/replace \"_\" \"-\") (->> (str \"edgar2.\") symbol))) (mapv #(doto % require))) r (apply t/run-tests nses)] (System/exit (+ (:fail r) (:error r))))"]}
  ; cli queries
  :run {:main-opts ["-m" "edgar2.filing"]}
  :download {:exec-fn edgar2.filing/download
             :exec-args {:ticker "XOM" :years 5}}
  :report {:exec-fn edgar2.filing/report
           :exec-args {:ticker "XOM" :years 5}}
  :financials {:exec-fn edgar2.filing/financials
               :exec-args {:ticker "XOM" :n 5}}
  :pl-fields {:exec-fn edgar2.filing/pl-fields
              :exec-args {:ticker "XOM"}}
  :business {:exec-fn edgar2.filing/business
             :exec-args {:ticker "XOM"}}
  :description {:exec-fn edgar2.description/description
                :exec-args {:ticker "MSFT"}}
  ; download
  :download-exchanges {:exec-fn edgar2.download.ticker-exchange/download-exchanges}
  :download-prices {:extra-deps {org.duckdb/duckdb_jdbc {:mvn/version "1.3.1.0"}}
                    :exec-fn edgar2.download.price/download-prices}
  :download-universe-fsds {:exec-fn edgar2.download.fsds-universe/filer-info}
  :download-fx {:exec-fn edgar2.download.fx/download-fx}
  :adr {:exec-fn edgar2.adr/run}
  ; universe 
  :universe-facts {:exec-fn edgar2.download.facts-universe/universe}
  :stats {:exec-fn edgar2.report.stats/stats}
  :cef {:exec-fn edgar2.report.cef/cef}
  :ingress {:extra-deps {org.duckdb/duckdb_jdbc {:mvn/version "1.3.1.0"}}
            :exec-fn edgar2.report.ingress/run}
  :ingress-eodhd {:exec-fn edgar2.eodhd.ingress/run}
  :ingress-all {:exec-fn edgar2.eodhd.ingress/run-all}
  :screen {:exec-fn edgar2.screen/run}
  :eodhd-screen {:exec-fn edgar2.screen/run
                 :exec-args {:name :lt-breakout}}
  ;; quanta-eodhd brings quanta-calendar 0.6.29, which has no aligned-ds-map.
  :nearness {:extra-deps {io.github.clojure-quant/quanta-calendar {:mvn/version "0.6.33"}
                          org.clojars.haifengl/smile {:mvn/version "4.2.0"}}
             :exec-fn edgar2.screen.nearness/run}
  :similar-behavior {:exec-fn edgar2.study.similar-behavior/run}
  :web {:extra-paths ["resources"]
        :extra-deps {ai.dyal/hyper {:mvn/version "0.2.2"}
                     org.duckdb/duckdb_jdbc {:mvn/version "1.3.1.0"}}
        :exec-fn edgar2.web.server/web
        :exec-args {:port 3000}}}}
